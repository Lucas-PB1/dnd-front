# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Local (alinhar com dnd-api DATABASE_URL / `npx supabase status`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  (PUBLISHABLE_KEY do status)
#
# Cloud:
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave

# API Nest (repo irmão dnd-api — dnd-work/dnd-api)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Opcional (só .env.local): pré-preenche /login em development
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=voce@exemplo.com
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
